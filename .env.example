# Copy to .env and fill in. Never commit .env.
# Values below are documentation placeholders (RFC 2606 names, RFC 5737 IPs).

## Chapter 01: private network
# Overlay network IP of the host. Media and anything clients reach directly binds here.
OVERLAY_IP=192.0.2.10

## Chapter 02: homeserver
# The part after ":" in user IDs. Cannot change later.
SERVER_NAME=example.com
# The host clients actually connect to, on the overlay network.
HS_HOST=mesh-host.example.net
# Where the two .well-known files are served (usually the same as SERVER_NAME).
WELLKNOWN_HOST=example.com
# Absolute path for all persistent data. Outside the repo. Back it up.
# macOS: use $HOME/mesh-data written out in full and skip sudo. The root volume
# is read-only, and Docker Desktop shares /Users with containers by default.
MESH_DATA_DIR=/srv/mesh-data
# User and group the homeserver container writes files as.
MESH_UID=1000
MESH_GID=1000

# Pinned versions: copy from VERSIONS.md.
POSTGRES_TAG=16-alpine
SYNAPSE_TAG=v1.152.1
# Secrets: generate each with `openssl rand -hex 32`. Never reuse them.
POSTGRES_PASSWORD=change-me
REGISTRATION_SHARED_SECRET=change-me
MACAROON_SECRET_KEY=change-me
FORM_SECRET=change-me

## Chapter 02b: calls (optional)
LIVEKIT_TAG=v1.11.0
LK_JWT_TAG=0.4.4
# Key name: any short identifier. Secret: `openssl rand -hex 32`.
LIVEKIT_KEY=mesh-calls
LIVEKIT_SECRET=change-me

## Chapter 03: first agent
# Pin from VERSIONS.md.
BAIBOT_TAG=latest@sha256:54280f03184b5016f6d4e9ab8b562a39db721b0cd3fff6564adec906c6a3ab71
# A model your runtime has pulled and that supports tool calling.
LOCAL_MODEL=qwen3:8b
# The model runtime's OpenAI-compatible address as containers reach it. The example is the
# reference runtime's default port. Every template that calls the runtime uses this value.
MODEL_RUNTIME_URL=http://host.docker.internal:11434/v1
# Chapter 03: the same value as MODEL_RUNTIME_URL. Chapter 04 changes this to the gateway.
LOCAL_AGENT_BASE_URL=http://host.docker.internal:11434/v1
# Secrets: `openssl rand -hex 32` for each.
LOCAL_AGENT_PASSWORD=change-me
LOCAL_AGENT_RECOVERY_PASSPHRASE=change-me
LOCAL_AGENT_SESSION_KEY=change-me
LOCAL_AGENT_CONFIG_KEY=change-me

## Chapter 04: tool gateway
# The tag of your own build of specs/tool-gateway.md.
TOOL_GATEWAY_IMAGE=tool-gateway:dev
# The default can stay if you skip the cloud agent. Otherwise any model your hosted provider offers.
CLOUD_MODEL=google/gemini-2.5-flash
# Keys for the hosted provider and the web search API. Compose passes them to the gateway container only.
# Keep this file at mode 600 (chmod 600 .env).
HOSTED_PROVIDER_API_KEY=change-me
SEARCH_API_KEY=change-me
# In this chapter, change LOCAL_AGENT_BASE_URL (chapter 03) to
# http://tool-gateway:8101/agents/local-agent/v1 so the agent goes through the gateway.

## Chapter 05: scribe
# The tag of your own build of specs/scribe.md.
SCRIBE_IMAGE=scribe:dev
# An IANA time zone name such as UTC. It sets every digest date and schedule.
SCRIBE_TIMEZONE=UTC
# Matrix password of the scribe account: `openssl rand -hex 32`. Used for the first login only.
SCRIBE_PASSWORD=change-me

## Chapter 06: knowledge store
# Pin from VERSIONS.md.
QDRANT_TAG=v1.18.0
KNOWLEDGE_MCP_TAG=2.1.0
# Where your knowledge store listens, as the MCP server container reaches it. On Linux
# host.docker.internal is the Docker bridge address, so bind the store there (or put it on
# the mesh network); loopback alone is unreachable. Docker Desktop on macOS reaches loopback.
KNOWLEDGE_STORE_URL=http://host.docker.internal:3010
# A dedicated agent user in the knowledge store, so agent-written documents have their own author.
KNOWLEDGE_AGENT_EMAIL=agent@example.com
KNOWLEDGE_AGENT_PASSWORD=change-me
# The workspace id from the knowledge store. Chapter 06 copies it into the scribe config.
KNOWLEDGE_WORKSPACE_ID=change-me
